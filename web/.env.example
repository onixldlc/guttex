# Dev only. Consumed by vite.config.ts, never bundled into the browser build.

# ghidra-rest instance the dev proxy forwards /api/* to.
GHIDRAREST_URL=http://127.0.0.1:8080

# Sent as `Authorization: Bearer ...` on every proxied request. Leave empty
# when the ghidra-rest instance runs without GHIDRAREST_TOKEN.
GHIDRAREST_TOKEN=

# Vite dev server port.
PORT=5173
